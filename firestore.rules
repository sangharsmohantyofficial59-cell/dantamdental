rules_version = '2';

// Nobody can read or write the database from a browser or app.
// All access happens on the server through the Firebase Admin key,
// which bypasses these rules. This means a visitor cannot open the
// browser console and read patients or edit bookings.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
