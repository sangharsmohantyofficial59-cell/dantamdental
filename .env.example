# Copy this file to .env.local and fill in the values. Never commit .env.local.

# From Firebase console > Project settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# From Firebase console > Project settings > Service accounts > Generate new private key
# Copy the three values from the downloaded JSON file. Keep the quotes on the private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Staff usernames become username@STAFF_EMAIL_DOMAIN inside Firebase. Any value works.
NEXT_PUBLIC_STAFF_EMAIL_DOMAIN=staff.dantam.local
STAFF_EMAIL_DOMAIN=staff.dantam.local

# Your public address, with no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development: open the front desk at http://admin.localhost:3000
ADMIN_HOST=admin.localhost
# Set to true only on a single-domain demo (for example a free vercel.app address).
# The front desk is then served at /admin. Leave false once you have the admin subdomain.
ALLOW_ADMIN_PATH=true

# Any long random text. Used to hash visitor addresses for the booking rate limit.
RATE_LIMIT_SALT=change-this-to-a-long-random-text
